@using BExIS.Utils.Extensions
@{
    string debugPath2 = "";
    if (Html.IsDebug())
    {
        debugPath2 = "BExIS.Modules.Dqm.UI/";
    }
}

@section scripts
{

}

<div id="dataquality">


</div>

@{
    var datasetId = ViewBag.Id ?? "";
    var datasetVersion = ViewBag.Version ?? "";
}
<div id="dataquality"></div>
<script type="text/javascript">
    // Werte direkt aus Razor in JS-Variablen
    const datasetId = "@datasetId";
    const datasetVersion = "@datasetVersion";

    if (!window.dataQualityWebComponentLoaded) {
        window.dataQualityWebComponentLoaded = true;
        const script = document.createElement('script');
        script.type = 'module';
        script.src = '/Areas/DQM/BExIS.Modules.Dqm.UI/Scripts/data-quality.js';
        document.head.appendChild(script);
    }

    customElements.whenDefined('data-quality').then(() => {
        const container = document.getElementById('dataquality');
        if (container) {
            // Entferne alte Instanzen
            Array.from(container.querySelectorAll('data-quality')).forEach(el => el.remove());

            const widget = document.createElement('data-quality');
            widget.setAttribute('datasetid', datasetId);
            widget.setAttribute('version', datasetVersion);
            container.appendChild(widget);
        }
    });
</script>